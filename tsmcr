<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Feature adoption</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f2f3fa;--card:#fff;--hov:#f6f7fd;--ink:#0f1633;--mut:#6a7390;--line:#e4e7f2;--track:#e8ebf6;--acc:#5b4bff;--r:#e5484d;--a:#e8920c;--g:#12a865;--rbg:rgba(229,72,77,.12);--abg:rgba(232,146,12,.14);--gbg:rgba(18,168,101,.13)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0a0e22;--card:#121833;--hov:#171e3f;--ink:#eef0fb;--mut:#98a0bf;--line:#222a4d;--track:#1d2545;--acc:#8b7dff;--r:#ff6b70;--a:#ffb937;--g:#2fd58a;--rbg:rgba(255,107,112,.15);--abg:rgba(255,185,55,.15);--gbg:rgba(47,213,138,.15)}}
:root[data-theme="dark"]{--bg:#0a0e22;--card:#121833;--hov:#171e3f;--ink:#eef0fb;--mut:#98a0bf;--line:#222a4d;--track:#1d2545;--acc:#8b7dff;--r:#ff6b70;--a:#ffb937;--g:#2fd58a;--rbg:rgba(255,107,112,.15);--abg:rgba(255,185,55,.15);--gbg:rgba(47,213,138,.15)}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;min-height:100vh;color:var(--ink);font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:radial-gradient(900px 420px at 88% -8%,color-mix(in srgb,var(--acc) 20%,transparent),transparent 70%),var(--bg);padding:28px 20px 40px}
.wrap{max-width:1180px;margin:0 auto}
header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
h1{font-size:32px;font-weight:800;letter-spacing:-.03em;margin:0}
.sub{color:var(--mut);font-size:14px;margin:6px 0 0}
.ctl{display:flex;gap:8px}
.btn{font:inherit;font-size:13px;font-weight:600;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 13px;cursor:pointer}
.btn:hover{border-color:var(--acc)}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.note{margin:16px 0 18px;font-size:13px;color:var(--mut);background:var(--abg);border-radius:12px;padding:10px 14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px}
.hero{display:grid;grid-template-columns:minmax(300px,380px) 1fr;gap:16px;margin-bottom:16px}
.ringcard{padding:24px;display:flex;flex-direction:column;align-items:center;gap:20px}
.ringwrap{position:relative;width:216px;height:216px}
.ring{position:absolute;inset:0;border-radius:50%;-webkit-mask:radial-gradient(circle,transparent 62%,#000 63%);mask:radial-gradient(circle,transparent 62%,#000 63%)}
.rc{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.rc b{font-size:56px;font-weight:800;letter-spacing:-.04em;line-height:1}
.rc span{font-size:12px;color:var(--mut);margin-top:6px}
.legend{width:100%;display:grid;gap:6px}
.lg{display:flex;align-items:center;gap:10px;width:100%;font:inherit;font-size:13px;color:var(--ink);background:transparent;border:1px solid transparent;border-radius:10px;padding:8px 10px;cursor:pointer;text-align:left}
.lg:hover,.lg.on{background:var(--hov);border-color:var(--line)}
.lg i{width:10px;height:10px;border-radius:3px;flex:none}
.lg span{flex:1}.lg b{font-variant-numeric:tabular-nums}
.stats{padding:26px;display:flex;flex-direction:column;justify-content:space-between;gap:22px}
.stats h2{font-size:15px;font-weight:700;margin:0;color:var(--mut)}
.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:18px}
.nums div b{display:block;font-size:40px;font-weight:800;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1.05}
.nums div span{font-size:13px;color:var(--mut)}
.split{height:16px;border-radius:999px;background:var(--abg);overflow:hidden}
.split i{display:block;height:100%;background:var(--g);border-radius:999px}
.splitl{display:flex;justify-content:space-between;font-size:12px;color:var(--mut);margin-top:8px}
.chip{display:inline-flex;gap:8px;align-items:center;font-size:13px;font-weight:600;color:var(--g);background:var(--gbg);border-radius:999px;padding:7px 13px;align-self:flex-start}
.panel{overflow:hidden}
.bar{display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line)}
.search{flex:1 1 240px;max-width:340px;font:inherit;font-size:14px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:10px 14px}
.search:focus{outline:2px solid var(--acc);outline-offset:0;border-color:var(--acc)}
.fl{display:flex;gap:6px;flex-wrap:wrap}
.fb{font:inherit;font-size:13px;font-weight:600;color:var(--mut);background:transparent;border:1px solid var(--line);border-radius:999px;padding:7px 13px;cursor:pointer}
.fb.on{color:var(--ink);background:var(--hov);border-color:var(--acc)}
.scroll{max-height:640px;overflow:auto}
table{width:100%;min-width:820px;border-collapse:separate;border-spacing:0;font-size:14px}
th{position:sticky;top:0;z-index:1;background:var(--card);text-align:left;font-size:12px;font-weight:600;color:var(--mut);padding:12px 16px;border-bottom:1px solid var(--line);cursor:pointer;user-select:none;white-space:nowrap}
th:hover{color:var(--ink)}
td{padding:11px 16px;border-bottom:1px solid var(--line);white-space:nowrap;font-variant-numeric:tabular-nums}
tbody tr{cursor:pointer}tbody tr:hover{background:var(--hov)}
.n{text-align:right}
.co{display:flex;align-items:center;gap:12px}
.av{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;color:#fff;font-size:13px;font-weight:700;flex:none}
.co b{font-weight:600;display:block}.co small{color:var(--mut);font-size:12px}
.gauge{--c:var(--g);width:44px;height:44px;border-radius:50%;background:conic-gradient(var(--c) calc(var(--p)*1%),var(--track) 0);display:inline-grid;place-items:center;position:relative;font-size:12px;font-weight:700;color:var(--c)}
.gauge::before{content:"";position:absolute;inset:5px;border-radius:50%;background:var(--card)}
tr:hover .gauge::before{background:var(--hov)}
.gauge i{position:relative;font-style:normal}
.tr{display:flex;align-items:center;gap:10px;justify-content:flex-end}
.d{font-weight:700;font-size:13px;min-width:44px;text-align:right}
.up{color:var(--g)}.dn{color:var(--r)}
.foot{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;padding:13px 20px;font-size:12px;color:var(--mut)}
.scrim{position:fixed;inset:0;background:rgba(5,8,20,.5);backdrop-filter:blur(3px);opacity:0;pointer-events:none;transition:opacity .2s;z-index:20}
.scrim.open{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(460px,100%);background:var(--card);border-left:1px solid var(--line);padding:24px;padding-top:calc(24px + env(safe-area-inset-top,0px));overflow:auto;transform:translateX(102%);transition:transform .25s ease;z-index:21}
.drawer.open{transform:none}
.dh{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:20px}
.dh .co b{font-size:20px;font-weight:800;letter-spacing:-.02em}
.ds{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:22px}
.ds div{background:var(--bg);border-radius:14px;padding:12px 8px;text-align:center}
.ds b{display:block;font-size:22px;font-weight:800}.ds span{font-size:11px;color:var(--mut)}
.dt{font-size:13px;font-weight:700;color:var(--mut);margin:0 0 10px}
.qs{display:flex;gap:10px;align-items:flex-end;height:96px;margin-bottom:24px}
.qs div{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px;height:100%;font-size:12px;color:var(--mut)}
.qs i{display:block;width:100%;border-radius:8px 8px 4px 4px;min-height:4px}
.qs b{color:var(--ink);font-size:12px}
.ft{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--line);font-size:14px}
.ft:last-child{border:0}
.st{font-size:12px;font-weight:600;padding:4px 10px;border-radius:999px;white-space:nowrap}
.on1{background:var(--gbg);color:var(--g)}.off1{background:var(--abg);color:var(--a)}
@media (max-width:820px){.hero{grid-template-columns:1fr}h1{font-size:26px}.ds{grid-template-columns:repeat(2,1fr)}}
@media (prefers-reduced-motion:reduce){.drawer,.scrim{transition:none}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div><h1 data-t="title"></h1><p class="sub" id="sub"></p></div>
    <div class="ctl"><button class="btn" id="lang">ES</button><button class="btn" id="theme" aria-label="Toggle theme">◐</button></div>
  </header>
  <div class="note" data-t="disc"></div>

  <section class="hero">
    <div class="card ringcard">
      <div class="ringwrap"><div class="ring" id="ring"></div><div class="rc"><b id="avg"></b><span data-t="avgL"></span></div></div>
      <div class="legend" id="legend"></div>
    </div>
    <div class="card stats">
      <h2 data-t="pva"></h2>
      <div class="nums" id="nums"></div>
      <div><div class="split"><i id="split"></i></div><div class="splitl" id="splitl"></div></div>
      <span class="chip" id="chip"></span>
    </div>
  </section>

  <section class="card panel">
    <div class="bar">
      <input class="search" id="q" type="text" data-ph="search" autocomplete="off">
      <div class="fl" id="fl"></div>
    </div>
    <div class="scroll"><table><thead><tr id="head"></tr></thead><tbody id="rows"></tbody></table></div>
    <div class="foot"><span id="cnt"></span><span data-t="rule"></span></div>
  </section>
</div>
<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" aria-label="Company detail"></aside>

<script>
const S={en:{title:"Feature adoption",sub:n=>`${n} companies, Q3 2026`,disc:"Illustrative mockup: every figure is fictitious, including those shown under real company names.",avgL:"average adoption",pva:"Purchased vs activated features",pur:"Purchased",act:"Activated",pen:"Purchased, not activated",imp:n=>`${n} companies improved vs Q2`,search:"Search company or sector",all:"All",lo:"Low (under 50%)",mid:"Medium (50–69%)",hi:"Healthy (70–100%)",co:"Company",ad:"Adoption",tr:"Trend vs Q2",shown:(a,b)=>`Showing ${a} of ${b} companies`,rule:"Adoption = activated ÷ purchased features",close:"Close",na:"Not activated",hist:"Adoption by quarter",feats:"Features",on:"Activated",off:"Purchased, not activated",cos:"companies"},
es:{title:"Adopción de features",sub:n=>`${n} empresas, T3 2026`,disc:"Mockup ilustrativo: todas las cifras son ficticias, incluso las de empresas con nombre real.",avgL:"adopción promedio",pva:"Features comprados vs activados",pur:"Comprados",act:"Activados",pen:"Comprados sin activar",imp:n=>`${n} empresas mejoraron vs T2`,search:"Buscar empresa o sector",all:"Todas",lo:"Baja (menos de 50%)",mid:"Media (50–69%)",hi:"Saludable (70–100%)",co:"Empresa",ad:"Adopción",tr:"Tendencia vs T2",shown:(a,b)=>`Mostrando ${a} de ${b} empresas`,rule:"Adopción = activados ÷ comprados",close:"Cerrar",na:"Sin activar",hist:"Adopción por trimestre",feats:"Features",on:"Activado",off:"Comprado sin activar",cos:"empresas"}};
const SECT={tech:["Technology","Tecnología"],sec:["Cybersecurity","Ciberseguridad"],fin:["Financial services","Servicios financieros"],ret:["Retail","Retail"],hlt:["Healthcare","Salud"],ind:["Industrial","Industrial"],aut:["Automotive","Automotriz"],enr:["Energy","Energía"],log:["Logistics","Logística"],food:["Food & beverage","Alimentos y bebidas"],ins:["Insurance","Seguros"],med:["Media","Medios"],prof:["Professional services","Servicios profesionales"],div:["Diversified","Diversificado"]};
const FEATS=[["SSO Federation","Federación SSO"],["SCIM Provisioning","Aprovisionamiento SCIM"],["Adaptive MFA","MFA adaptativo"],["Access Control","Control de acceso"],["Advanced Threat Protection","Protección avanzada de amenazas"],["Sandbox Analysis","Análisis en sandbox"],["Advanced DLP","DLP avanzado"],["CASB","CASB"],["Private Access","Acceso privado"],["Web Filtering","Filtrado web"],["Cloud Firewall","Firewall en la nube"],["Browser Isolation","Aislamiento de navegador"],["Digital Experience","Experiencia digital"],["Advanced Reporting","Reportes avanzados"]];
const NAMED=[["Microsoft","tech"],["Apple","tech"],["DigiCert","sec"],["Google","tech"],["Amazon","ret"],["Oracle","tech"],["IBM","tech"],["Cisco","tech"],["Salesforce","tech"],["Adobe","tech"],["Intel","tech"],["Dell Technologies","tech"],["HP","tech"],["NVIDIA","tech"],["SAP","tech"],["Okta","sec"],["CrowdStrike","sec"],["Palo Alto Networks","sec"],["Fortinet","sec"],["Splunk","sec"],["ServiceNow","tech"],["Workday","tech"],["Snowflake","tech"],["Atlassian","tech"],["Cloudflare","sec"],["Akamai","sec"],["Visa","fin"],["Mastercard","fin"],["JPMorgan Chase","fin"],["Walmart","ret"],["Target","ret"],["Costco","ret"],["The Home Depot","ret"],["Boeing","ind"],["Ford","aut"],["General Motors","aut"],["Pfizer","hlt"],["Johnson & Johnson","hlt"],["UnitedHealth Group","hlt"],["ExxonMobil","enr"],["FedEx","log"],["UPS","log"],["PepsiCo","food"],["Disney","med"]];
const PRE=["Atlas","Nova","Summit","Crestline","Harbor","Pinnacle","Meridian","Vertex","Solace","Ironwood","Bluewater","Cedar","Northstar","Silverline","Oakridge","Granite","Redwood","Sterling","Lumen","Orion","Pacifica","Evergreen","Keystone","Aurora","Beacon","Caliber","Dominion","Eastgate","Frontier","Gateway","Highland","Inland","Juniper","Kestrel","Lakeside","Mariner","Nexus","Obsidian","Prairie","Quantum","Riverstone","Sequoia","Tidewater","Unity","Valor","Westbrook","Zenith","Argent","Copperfield","Halcyon","Monarch","Northwind","Pioneer","Ridgeway"];
const SUF={Group:"div",Holdings:"fin",Systems:"tech",Industries:"ind",Financial:"fin",Logistics:"log",Energy:"enr",Health:"hlt",Retail:"ret",Motors:"aut",Partners:"prof",Global:"div",Technologies:"tech",Foods:"food",Insurance:"ins",Media:"med"};

function rng(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const rnd=rng(20261014);
const shuf=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(rnd()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const cl=v=>Math.max(0,Math.min(100,v));
const mk=(name,sk,big)=>{
  const bought=big?8+Math.floor(rnd()*7):4+Math.floor(rnd()*9);
  const m=.12+rnd()*.86;
  const feats=shuf([...FEATS.keys()]).slice(0,bought).map(i=>({i,on:rnd()<m}));
  const active=feats.filter(f=>f.on).length, q3=Math.round(active/bought*100);
  const q2=cl(q3-Math.round(rnd()*22-5)), q1=cl(q2-Math.round(rnd()*22-5));
  return{name,sk,feats,bought,active,pen:bought-active,ad:q3,q:[q1,q2,q3],dl:q3-q2};
};
const combos=[];PRE.forEach(p=>Object.keys(SUF).forEach(s=>combos.push([p,s])));shuf(combos);
const DATA=[...NAMED.map(([n,s])=>mk(n,s,true)),...combos.slice(0,500-NAMED.length).map(([p,s])=>mk(`${p} ${s}`,SUF[s],false))];

const $=id=>document.getElementById(id);
const esc=s=>s.replace(/&/g,"&amp;");
const band=v=>v>=70?"g":v>=50?"a":"r";
const fmt=n=>n.toLocaleString(lang==="en"?"en-US":"es-MX");
let lang="en",flt="all",qry="",sk="ad",sd=-1;
const t=k=>S[lang][k], sec=c=>SECT[c.sk][lang==="en"?0:1], fn=i=>FEATS[i][lang==="en"?0:1];
const hue=n=>{let h=0;for(const ch of n)h=(h*31+ch.charCodeAt(0))%360;return h};
const ini=n=>{const w=n.replace(/[^A-Za-z ]/g,"").split(" ").filter(Boolean);return(w.length>1?w[0][0]+w[1][0]:w[0].slice(0,2)).toUpperCase()};
const av=n=>{const h=hue(n);return`<span class="av" style="background:linear-gradient(135deg,hsl(${h} 68% 54%),hsl(${(h+40)%360} 68% 42%))">${ini(n)}</span>`};
const spark=(q,c)=>{const y=v=>22-v*.2;return`<svg width="64" height="26" viewBox="0 0 64 26" aria-hidden="true"><polyline points="${q.map((v,i)=>`${4+i*28},${y(v)}`).join(" ")}" fill="none" stroke="var(--${c})" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="60" cy="${y(q[2])}" r="3" fill="var(--${c})"/></svg>`};
const FL=[["all",null],["lo","r"],["mid","a"],["hi","g"]], BK={r:"lo",a:"mid",g:"hi"};

function statics(){
  document.documentElement.lang=lang;
  document.querySelectorAll("[data-t]").forEach(e=>e.textContent=t(e.dataset.t));
  document.querySelectorAll("[data-ph]").forEach(e=>e.placeholder=t(e.dataset.ph));
  $("sub").textContent=t("sub")(DATA.length);
  $("lang").textContent=lang==="en"?"ES":"EN";
  const tb=DATA.reduce((a,c)=>a+c.bought,0), ta=DATA.reduce((a,c)=>a+c.active,0), n=DATA.length;
  const avg=Math.round(ta/tb*100), cnt={r:0,a:0,g:0};
  DATA.forEach(c=>cnt[band(c.ad)]++);
  const x=cnt.r/n*100, y=x+cnt.a/n*100;
  $("ring").style.background=`conic-gradient(var(--r) 0 ${x}%,var(--a) ${x}% ${y}%,var(--g) ${y}% 100%)`;
  $("avg").textContent=avg+"%"; $("avg").style.color=`var(--${band(avg)})`;
  $("legend").innerHTML=["r","a","g"].map(b=>`<button class="lg ${flt===BK[b]?"on":""}" data-f="${BK[b]}"><i style="background:var(--${b})"></i><span>${t(BK[b])}</span><b>${cnt[b]}</b></button>`).join("");
  $("nums").innerHTML=`<div><b>${fmt(tb)}</b><span>${t("pur")}</span></div><div><b style="color:var(--g)">${fmt(ta)}</b><span>${t("act")}</span></div><div><b style="color:var(--a)">${fmt(tb-ta)}</b><span>${t("pen")}</span></div>`;
  $("split").style.width=(ta/tb*100)+"%";
  $("splitl").innerHTML=`<span>${t("act")} ${Math.round(ta/tb*100)}%</span><span>${t("na")} ${100-Math.round(ta/tb*100)}%</span>`;
  $("chip").textContent="▲ "+t("imp")(DATA.filter(c=>c.dl>0).length);
  document.querySelectorAll("#legend .lg").forEach(b=>b.onclick=()=>{flt=flt===b.dataset.f?"all":b.dataset.f;statics();table()});
  $("fl").innerHTML=FL.map(([k,b])=>`<button class="fb ${flt===k?"on":""}" data-f="${k}">${t(k)}</button>`).join("");
  document.querySelectorAll("#fl .fb").forEach(b=>b.onclick=()=>{flt=b.dataset.f;statics();table()});
}
const COLS=[["name","co"],["bought","pur",1],["active","act",1],["pen","pen",1],["ad","ad",1],["dl","tr",1]];
function table(){
  $("head").innerHTML=COLS.map(([k,l,n])=>`<th class="${n?"n":""}" data-k="${k}">${t(l)}${sk===k?(sd>0?" ↑":" ↓"):""}</th>`).join("");
  document.querySelectorAll("#head th").forEach(th=>th.onclick=()=>{const k=th.dataset.k;if(sk===k)sd*=-1;else{sk=k;sd=k==="name"?1:-1}table()});
  const q=qry.toLowerCase();
  const L=DATA.filter(c=>(flt==="all"||BK[band(c.ad)]===flt)&&(!q||c.name.toLowerCase().includes(q)||sec(c).toLowerCase().includes(q)));
  L.sort((a,b)=>(typeof a[sk]==="string"?a[sk].localeCompare(b[sk]):a[sk]-b[sk])*sd);
  $("rows").innerHTML=L.map(c=>{const b=band(c.ad),up=c.dl>=0;return`<tr data-i="${DATA.indexOf(c)}"><td><div class="co">${av(c.name)}<span><b>${esc(c.name)}</b><small>${sec(c)}</small></span></div></td><td class="n">${c.bought}</td><td class="n" style="color:var(--g)">${c.active}</td><td class="n" style="color:var(--a)">${c.pen}</td><td class="n"><span class="gauge" style="--p:${c.ad};--c:var(--${b})"><i>${c.ad}</i></span></td><td class="n"><div class="tr">${spark(c.q,up?"g":"r")}<span class="d ${up?"up":"dn"}">${c.dl===0?"–":(up?"▲ ":"▼ ")+Math.abs(c.dl)}</span></div></td></tr>`}).join("");
  document.querySelectorAll("#rows tr").forEach(r=>r.onclick=()=>open(DATA[r.dataset.i]));
  $("cnt").textContent=t("shown")(L.length,DATA.length);
}
let cur=null;
function open(c){
  cur=c;const b=band(c.ad);
  $("drawer").innerHTML=`<div class="dh"><div class="co">${av(c.name)}<span><b>${esc(c.name)}</b><small>${sec(c)}</small></span></div><button class="btn" id="x">${t("close")}</button></div>
  <div class="ds"><div><b>${c.bought}</b><span>${t("pur")}</span></div><div><b style="color:var(--g)">${c.active}</b><span>${t("act")}</span></div><div><b style="color:var(--a)">${c.pen}</b><span>${t("na")}</span></div><div><b style="color:var(--${b})">${c.ad}%</b><span>${t("ad")}</span></div></div>
  <p class="dt">${t("hist")}</p>
  <div class="qs">${c.q.map((v,i)=>`<div><b>${v}%</b><i style="height:${Math.max(v*.62,4)}px;background:var(--${band(v)})"></i>${lang==="en"?"Q":"T"}${i+1}</div>`).join("")}</div>
  <p class="dt">${t("feats")}</p>
  ${c.feats.slice().sort((a,b)=>b.on-a.on||fn(a.i).localeCompare(fn(b.i))).map(f=>`<div class="ft"><span>${fn(f.i)}</span><span class="st ${f.on?"on1":"off1"}">${f.on?t("on"):t("off")}</span></div>`).join("")}`;
  $("x").onclick=close;$("drawer").classList.add("open");$("scrim").classList.add("open");$("x").focus();
}
function close(){cur=null;$("drawer").classList.remove("open");$("scrim").classList.remove("open")}
$("scrim").onclick=close;
document.addEventListener("keydown",e=>{if(e.key==="Escape")close()});
$("q").addEventListener("input",e=>{qry=e.target.value;table()});
$("lang").onclick=()=>{lang=lang==="en"?"es":"en";statics();table();if(cur)open(cur)};
$("theme").onclick=()=>{const r=document.documentElement,dark=r.dataset.theme?r.dataset.theme==="dark":matchMedia("(prefers-color-scheme:dark)").matches;r.dataset.theme=dark?"light":"dark"};
statics();table();
</script>
</body>
</html>
